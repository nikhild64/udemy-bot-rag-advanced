PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DATA_INPUT_DIRECTORY=./data/input

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/neondb?sslmode=require

# Supabase Storage Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=notebook-sources

# Redis Configuration (Upstash Redis or Standard Redis)
# Option 1: Standard Redis URL (Works with Upstash TCP rediss:// or local redis://)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# Option 2: Upstash REST Credentials (Automatically converted if REDIS_URL is omitted)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Provider Selection ('mistral' or 'nvidia')
CHAT_PROVIDER=nvidia
EMBEDDING_PROVIDER=nvidia

# NVIDIA Provider Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_QUERY_TRANSFORMATION_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024

# Mistral Provider Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_API_URL=https://api.mistral.ai/v1/embeddings
QUERY_TRANSFORMATION_MODEL=mistral-small-latest
RERANK_MODEL=mistral-small-latest
CHAT_MODEL=mistral-medium-latest

# Embedding Execution Settings
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30000

# Vector Store Provider Configuration
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
VECTOR_COLLECTION_NAME=knowledge-base
SYSTEM_KNOWLEDGE_COLLECTION=system-knowledge
USER_KNOWLEDGE_COLLECTION=user-knowledge
VECTOR_DISTANCE_METRIC=Cosine
VECTOR_STORE_TIMEOUT=30000

# Authentication Configuration (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_...
