# App & Server Settings
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_USER_IDS=

# Data Directories
DATA_INPUT_DIRECTORY=./data/input
DATA_EXTRACTION_DIRECTORY=./data/extracted

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/neondb?sslmode=require

# Supabase Storage Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=notebook-sources

# Redis Configuration (Upstash Redis or Standard Redis)
# Option 1: Standard Redis URL (Works with Upstash TCP rediss:// or local redis://)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# Option 2: Upstash REST Credentials (Automatically converted if REDIS_URL is omitted)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Provider Selection ('mistral' or 'nvidia')
CHAT_PROVIDER=nvidia
EMBEDDING_PROVIDER=nvidia
# TTS Provider: web_speech (default/free) | mistral (cloud REST) | nvidia (self-hosted gRPC NIM only)
# NOTE: NVIDIA TTS NIMs are gRPC-based and NOT available via integrate.api.nvidia.com REST.
# For cloud REST TTS, use TTS_PROVIDER=mistral with MISTRAL_API_KEY set.
TTS_PROVIDER=web_speech
# Required only if TTS_PROVIDER=nvidia (self-hosted NVIDIA Riva NIM container)
NVIDIA_TTS_BASE_URL=
# Required only if TTS_PROVIDER=mistral
# Run: cd rag-engine && npx ts-node scripts/setup-mistral-voices.ts
# Place alex-sample.mp3 and jamie-sample.mp3 in rag-engine/scripts/voice-samples/ first
MISTRAL_MALE_VOICE_ID=en_paul_cheerful
MISTRAL_FEMALE_VOICE_ID=gb_jane_confident

# NVIDIA Provider Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_QUERY_TRANSFORMATION_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSION=1024

# Mistral Provider Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_API_URL=https://api.mistral.ai/v1/embeddings
QUERY_TRANSFORMATION_MODEL=mistral-small-latest
RERANK_MODEL=mistral-small-latest
CHAT_MODEL=mistral-medium-latest
CHAT_TIMEOUT=30000

# Retrieval & Reranking Strategy
QUERY_TRANSFORMATION_STRATEGY=llm
RERANKER_PROVIDER=llm
RERANKER_TOP_K=10
RERANKER_BATCH_SIZE=10

# CRAG (Corrective Retrieval-Augmented Generation) Configuration
CRAG_ENABLED=true
CRAG_STRATEGY=hybrid
CRAG_SIMILARITY_THRESHOLD=0.7
CRAG_MAX_RETRIES=2
CRAG_LIMIT_INCREMENT=5
CRAG_MAX_RETRIEVAL_LIMIT=30
CRAG_CORRECTIVE_STRATEGY=adaptive
CRAG_MIN_CHUNK_CONFIDENCE=0.5

# Embedding Execution Settings
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT=30000

# Vector Store Provider Configuration (Qdrant)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
VECTOR_COLLECTION_NAME=knowledge-base
SYSTEM_KNOWLEDGE_COLLECTION=system-knowledge
USER_KNOWLEDGE_COLLECTION=user-knowledge
VECTOR_DISTANCE_METRIC=Cosine
VECTOR_STORE_TIMEOUT=30000

# Chunking Configuration
CHUNK_MAX_CHARACTERS=1000
CHUNK_OVERLAP_CHARACTERS=200
CHUNK_MIN_CHARACTERS=50

# Ingestion & Worker Pipeline
INGESTION_PARSE_PREFERRED_ONLY=true
WORKER_CONCURRENCY=5
INGESTION_RETRY_COUNT=3
INGESTION_RETRY_DELAY_MS=1000
SOURCE_CHUNK_SIZE=500
SOURCE_CHUNK_OVERLAP=50

# Indexing Configuration
INDEXING_BATCH_SIZE=100
INDEXING_MAX_RETRIES=3
INDEXING_RETRY_DELAY=1000

# Upload Configuration
UPLOAD_MAX_FILE_SIZE=52428800
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,text/plain,text/vtt,application/x-subrip,application/octet-stream,application/zip,application/x-zip-compressed
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.txt,.vtt,.srt,.zip

# Input Guardrails Configuration
INPUT_MAX_QUERY_LENGTH=4000
ALLOW_URLS=true
ENABLE_PROMPT_INJECTION_GUARD=true
ENABLE_JAILBREAK_GUARD=true
ENABLE_SQL_INJECTION_GUARD=true
ENABLE_XSS_GUARD=true
ENABLE_PATH_TRAVERSAL_GUARD=true
ENABLE_SPAM_GUARD=true
ENABLE_PII_GUARD=true

# Output Guardrails Configuration
OUTPUT_MAX_RESPONSE_LENGTH=25000
ENABLE_EMPTY_RESPONSE_GUARD=true
ENABLE_CITATION_GUARD=true
ENABLE_PROMPT_LEAKAGE_GUARD=true
ENABLE_CHAIN_OF_THOUGHT_GUARD=true
ENABLE_SENSITIVE_DATA_GUARD=true
ENABLE_HALLUCINATED_CITATION_GUARD=true
ENABLE_MARKDOWN_GUARD=true
ENABLE_HTML_GUARD=true

# Authentication Configuration (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_...
