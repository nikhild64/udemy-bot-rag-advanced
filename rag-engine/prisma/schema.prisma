// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  PDF
  WEBSITE
  YOUTUBE
  TEXT
  VTT
  DOCX
  PPTX
  GITHUB
  NOTION
  CONFLUENCE
  AUDIO
  MARKDOWN
  GOOGLE_DRIVE
}

enum SourceStatus {
  PendingUpload
  Uploading
  Uploaded
  Queued
  Processing
  Indexed
  Failed
  Deleted
  Cancelled
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id          String          @id
  email       String?
  name        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  notebooks   Notebook[]
  preference  UserPreference?

  @@map("users")
}

model Notebook {
  id           String    @id @default(uuid())
  title        String
  description  String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isArchived   Boolean   @default(false)
  isFavorite   Boolean   @default(false)
  lastOpenedAt DateTime? @default(now())
  settings     Json?     @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sources      Source[]
  messages     Message[]

  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, isFavorite])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notebooks")
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String   @default("system")
  language          String   @default("en")
  defaultNotebookId String?
  timezone          String   @default("UTC")
  notifications     Json?    @default("{\"uploadCompleted\":true,\"uploadFailed\":true,\"sourceIndexed\":true,\"processingFailed\":true,\"chatFailed\":true}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}

model Source {
  id          String       @id @default(uuid())
  notebookId  String
  notebook    Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  type        SourceType
  displayName String?
  title       String
  status      SourceStatus @default(PendingUpload)
  storagePath String?
  fileUrl     String?
  mimeType    String?
  size        Int?
  metadata    Json?        @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([notebookId])
  @@index([notebookId, status])
  @@index([notebookId, createdAt(sort: Desc)])
  @@map("sources")
}

model Message {
  id         String      @id @default(uuid())
  notebookId String
  notebook   Notebook    @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String      @db.Text
  citations  Json?       @default("[]")
  metadata   Json?       @default("{}")
  createdAt  DateTime    @default(now())

  @@index([notebookId])
  @@index([notebookId, createdAt(sort: Asc)])
  @@map("messages")
}
